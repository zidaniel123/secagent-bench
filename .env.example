# Copy to .env and fill in whichever providers you have access to.
# The suite skips providers with no key and still runs the rest.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=      # Kimi
ZHIPU_API_KEY=         # GLM

# Local model server (vLLM / Ollama). No key needed; override the URL if your
# server is not on localhost — e.g. a DGX box on your LAN.
# LOCAL_BASE_URL=http://localhost:8000/v1
